<Project>

  <!-- Shared build settings for every project in the repository (AGENTS.md 3.5 / 3.6 / docs/modules/build-scaffolding.md). -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- AGENTS.md 3.6: warnings are errors by default. Suppressions require a recorded justification. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Company>Sharpcraft contributors</Company>
    <Product>Sharpcraft</Product>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    AGENTS.md 3.6: trim/AOT compatibility analyzers are intentionally NOT enabled yet.
    They cannot be enabled while the runtime form (JIT / AOT / single-file) is still
    undecided (AGENTS.md 1, open item 1), because every pattern they flag would be a
    warning we are not allowed to suppress.
  -->
  <PropertyGroup>
    <IsTrimmable>false</IsTrimmable>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>


  <!-- Every map/targets file stays explicit: no hidden SDK magic beyond the above. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>

</Project>
