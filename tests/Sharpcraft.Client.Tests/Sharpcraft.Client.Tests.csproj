<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test-only oracle extracted from the local mc-26.3-analysis workspace by tools/Sharpcraft.ReferenceVerifier. -->
    <None Include="Render/ReferenceFacts/vanilla-model-facts.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Sharpcraft.Assets" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests share process-wide statics (ItemRegistry, EntityModelResolver caches); run collections serially. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sharpcraft.Assets\Sharpcraft.Assets.csproj" />
    <ProjectReference Include="..\..\src\Sharpcraft.Client\Sharpcraft.Client.csproj" />
  </ItemGroup>

</Project>
