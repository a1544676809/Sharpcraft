<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sharpcraft.Common\Sharpcraft.Common.csproj" />
    <ProjectReference Include="..\Sharpcraft.Framework\Sharpcraft.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The game library is reused by the launcher's dev/diagnostic tools only (ADR-0026); the product path
         starts the client as a separate process. Tests need the same access for the game-options contracts. -->
    <InternalsVisibleTo Include="Sharpcraft.Launcher" />
    <InternalsVisibleTo Include="Sharpcraft.Client.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
