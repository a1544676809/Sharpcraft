<!--
  Solution entry point for Visual Studio 2026 / dotnet CLI.

  Projects are added as they are created, following the layout in AGENTS.md 3.3.
  Keep folder names identical to the directory names so that `dotnet sln` and
  Visual Studio show the same tree.
-->
<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="x64" />
  </Configurations>
  <Folder Name="/src/">
    <Project Path="src/MinecraftCSharp.Auth/MinecraftCSharp.Auth.csproj" />
    <Project Path="src/MinecraftCSharp.Client/MinecraftCSharp.Client.csproj" />
    <Project Path="src/MinecraftCSharp.Common/MinecraftCSharp.Common.csproj" />
    <Project Path="src/MinecraftCSharp.Framework/MinecraftCSharp.Framework.csproj" />
    <Project Path="src/MinecraftCSharp.Launcher/MinecraftCSharp.Launcher.csproj" />
    <Project Path="src/MinecraftCSharp.Modding/MinecraftCSharp.Modding.csproj" />
    <Project Path="src/MinecraftCSharp.Server/MinecraftCSharp.Server.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/MinecraftCSharp.Architecture.Tests/MinecraftCSharp.Architecture.Tests.csproj" />
    <Project Path="tests/MinecraftCSharp.Common.Tests/MinecraftCSharp.Common.Tests.csproj" />
  </Folder>
</Solution>
