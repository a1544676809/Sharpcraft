<!--
  Solution template for Visual Studio 2026 / dotnet CLI.

  This file is the single entry point for build and debug (AGENTS.md 3.6), and it
  fixes the layout up front so new projects slot into an existing group instead of
  being appended ad hoc:

    /src/     game and host assemblies   (docs/architecture/boundaries.md)
    /tests/   unit, architecture and allocation tests

  Rules for adding a project:
    1. Directory must be src/<AssemblyName>/ or tests/<AssemblyName>/, matching the .csproj name.
    2. Add the <Project> entry to the matching folder, keeping entries alphabetical.
    3. Project references must satisfy B1-B3; tests/MinecraftCSharp.Architecture.Tests fails the build otherwise.
-->
<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="x64" />
  </Configurations>
  <Folder Name="/src/">
    <Project Path="src/MinecraftCSharp.Auth/MinecraftCSharp.Auth.csproj" />
    <Project Path="src/MinecraftCSharp.Client/MinecraftCSharp.Client.csproj" />
    <Project Path="src/MinecraftCSharp.Common/MinecraftCSharp.Common.csproj" />
    <Project Path="src/MinecraftCSharp.Framework/MinecraftCSharp.Framework.csproj" />
    <Project Path="src/MinecraftCSharp.Launcher/MinecraftCSharp.Launcher.csproj" />
    <Project Path="src/MinecraftCSharp.Modding/MinecraftCSharp.Modding.csproj" />
    <Project Path="src/MinecraftCSharp.Server/MinecraftCSharp.Server.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/MinecraftCSharp.Architecture.Tests/MinecraftCSharp.Architecture.Tests.csproj" />
    <Project Path="tests/MinecraftCSharp.Auth.Tests/MinecraftCSharp.Auth.Tests.csproj" />
    <Project Path="tests/MinecraftCSharp.Launcher.Tests/MinecraftCSharp.Launcher.Tests.csproj" />
    <Project Path="tests/MinecraftCSharp.Client.Tests/MinecraftCSharp.Client.Tests.csproj" />
    <Project Path="tests/MinecraftCSharp.Framework.Tests/MinecraftCSharp.Framework.Tests.csproj" />
    <Project Path="tests/MinecraftCSharp.Common.Tests/MinecraftCSharp.Common.Tests.csproj" />
  </Folder>
</Solution>
